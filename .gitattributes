# Normalise line endings: LF in the repo and in every working tree,
# regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts must stay CRLF to run correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.nsh  text eol=crlf

# Treat these as binary (never touch line endings, never diff as text).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.bcup  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
